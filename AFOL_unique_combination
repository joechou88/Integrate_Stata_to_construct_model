import pandas as pd
import config

ibes_non_us = pd.read_sas(config.IBES_NON_US_INPUT, encoding="latin1")
ibes_us = pd.read_sas(config.IBES_US_INPUT, encoding="latin1")
ibes_int = pd.read_sas(config.IBES_INT_INPUT, encoding="latin1")
stata_df = pd.read_stata(config.STATA_COUNTRY_LEVEL_CONTROLS_OUTPUT)
ibes_df = pd.concat([ibes_us, ibes_non_us, ibes_int], ignore_index=True)

stata_map = stata_df[['country', 'country_code']].drop_duplicates()
stata_map = stata_map.rename(columns={'country_code': 'country_code_stata'})

sas_map = ibes_df[['country', 'country_code']].drop_duplicates()
sas_map = sas_map.rename(columns={'country_code': 'country_code_sas'})
final_df = pd.merge(stata_map, sas_map, on='country', how='outer')

columns_order = ['country', 'country_code_sas', 'country_code_stata']
final_df = final_df.sort_values(by='country', na_position='last')

output_file = "list_unique_AFOL_combination.txt"
print(f"Saving results to {output_file}...")

with open(output_file, "w", encoding="utf-8") as f:
    f.write(final_df.to_string(index=False))